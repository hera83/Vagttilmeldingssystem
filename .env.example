# Kopiér filen til .env, og udfyld værdierne. .env må aldrig committes.
# Nøglerne bruger .NET's notation med dobbelt underscore: Users__InitialAdmin__UserName svarer til Users:InitialAdmin:UserName.

# Første administrator, kun når tabellen Users er tom. Brugernavnet skal være en e-mailadresse.
Users__InitialAdmin__UserName=
Users__InitialAdmin__Password=

# Web push (VAPID). Lav et nøglepar med: dotnet run --project web -- --generate-vapid-keys
# PrivateKey er en secret. Subject er en kontaktadresse til push-tjenesterne: mailto:<e-mail> eller https://<adresse>.
# Mangler en af værdierne, er push slået fra.
Push__PublicKey=
Push__PrivateKey=
Push__Subject=
