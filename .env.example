# Kopiér filen til .env, og udfyld værdierne. .env må aldrig committes.
# Nøglerne bruger .NET's notation med dobbelt underscore: Users__InitialAdmin__UserName svarer til Users:InitialAdmin:UserName.

# Første administrator, kun når tabellen Users er tom. Brugernavnet skal være en e-mailadresse.
Users__InitialAdmin__UserName=
Users__InitialAdmin__Password=

# Web push (VAPID). Lav et nøglepar med: docker compose run --rm web --generate-vapid-keys
# (eller dotnet run --project web -- --generate-vapid-keys på en udviklermaskine).
# PrivateKey er en secret. Subject er en kontaktadresse til push-tjenesterne: mailto:<e-mail> eller https://<adresse>.
# Mangler en af værdierne, er push slået fra.
Push__PublicKey=
Push__PrivateKey=
Push__Subject=

# Domænet, brugerne åbner systemet på, uden https:// (fx vagter.skolen.dk). Systemet sætter selv https:// foran.
# Bruges til links i e-mails (invitation, glemt adgangskode, bekræftelser), og systemet svarer kun på domænet (og localhost).
# Systemet skal have en reverse proxy med https foran (fx Caddy eller nginx). Den skal ikke konfigureres her.
App__Domain=

# E-mail. Alle mails sendes fra systemets egen postkasse (Mail__FromAddress), så svar lander i den indbakke, webmailen viser.
Mail__FromAddress=
Mail__FromName=Vagttilmelding
# Kun til udvikling (mails gemmes som filer i stedet for at blive sendt). Skal være tom i drift.
Mail__PickupDirectory=

# SMTP (afsendelse). Security: StartTls (typisk port 587), SslOnConnect (465) eller None. Password er en secret.
Mail__Smtp__Host=
Mail__Smtp__Port=587
Mail__Smtp__Security=StartTls
Mail__Smtp__UserName=
Mail__Smtp__Password=

# IMAP (læsning af systemets postkasse i webmailen). Security: SslOnConnect (typisk port 993) eller StartTls (143). Password er en secret.
Mail__Imap__Host=
Mail__Imap__Port=993
Mail__Imap__Security=SslOnConnect
Mail__Imap__UserName=
Mail__Imap__Password=
# Webmail: gem en kopi af mails skrevet i webmailen i Sendt (sæt false, hvis udbyderen selv gemmer, fx Gmail).
# Sendt og Papirkurv findes automatisk (IMAP special-use); navnene bruges kun, hvis serveren ikke oplyser dem.
Mail__Imap__SaveSentCopy=true
Mail__Imap__SentFolder=Sent
Mail__Imap__TrashFolder=Trash
# Hvor ofte antal ulæste hentes til dashboardet (sekunder).
Mail__Imap__PollIntervalSeconds=300

# Påmindelser 48 og 24 timer før vagtstart. Scanningen kører ved opstart og derefter hvert WorkerIntervalSeconds (3600 = én gang i timen).
Reminders__Enabled=true
Reminders__WorkerIntervalSeconds=3600

# Begrænsning af forsøg pr. IP-adresse (tilmelding: pr. bruger). Over grænsen svarer systemet "For mange forsøg" (429).
# Kører systemet bag en reverse proxy, skal proxyen sende X-Forwarded-For, ellers deler alle brugere samme grænse.
RateLimiting__Enabled=true
RateLimiting__LoginPermitLimit=10
RateLimiting__LoginWindowSeconds=300
RateLimiting__PasswordPermitLimit=5
RateLimiting__PasswordWindowSeconds=900
RateLimiting__EnrollPermitLimit=20
RateLimiting__EnrollWindowSeconds=60

# Sendte og opgivne beskeder (push og e-mail) slettes efter så mange dage. Udløbne adgangskode-links slettes altid.
DataRetention__NotificationDays=90
