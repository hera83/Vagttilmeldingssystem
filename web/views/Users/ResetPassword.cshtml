@model web.ViewModels.Users.ResetPasswordUsersViewModel
@{
    ViewData["Title"] = "Ny adgangskode";
}
<a class="back-link" asp-action="Index"><icon name="arrow-left" />Tilbage til brugere</a>
<div class="page-header">
    <div>
        <h1>Ny adgangskode</h1>
        <p>@Model.DisplayName (@Model.UserName) bliver logget ud alle steder og skal bruge den nye adgangskode.</p>
    </div>
</div>

<div class="card form">
    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="NewPassword" class="required"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span class="help">Mindst 12 tegn.</span>
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword" class="required"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><icon name="key" />Sæt ny adgangskode</button>
            <a class="btn btn-ghost" asp-action="Index">Annuller</a>
        </div>
    </form>
</div>
