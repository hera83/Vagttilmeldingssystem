@model web.ViewModels.Users.ProfileUsersViewModel
@{
    ViewData["Title"] = $"Profil: {Model.DisplayName}";
}
<a class="back-link" asp-action="Index"><icon name="arrow-left" />Tilbage til brugere</a>
<div class="page-header">
    <div>
        <h1>@Model.DisplayName</h1>
        <p>@Model.UserName</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id"><icon name="edit" />Ret bruger</a>
        <a class="btn btn-secondary" asp-action="Export" asp-route-id="@Model.Id" title="Alle oplysninger om brugeren som JSON-fil (indsigt)"><icon name="download" />Hent data</a>
        @if (!Model.IsCurrentUser)
        {
            <form asp-action="Anonymize" asp-route-id="@Model.Id" method="post"
                  data-confirm="Vil du anonymisere @Model.DisplayName? Profil, push og ventende beskeder slettes, brugeren kan ikke logge ind igen, og vagthistorikken står som »Slettet bruger«. Det kan ikke fortrydes.">
                <button type="submit" class="btn btn-danger"><icon name="eye-off" />Anonymisér</button>
            </form>
        }
    </div>
</div>

<section class="card form" aria-labelledby="profile-title">
    <div class="card-header">
        <span class="card-icon"><icon name="user" /></span>
        <div>
            <h2 id="profile-title">Profil</h2>
            @if (Model.HasProfile)
            {
                <p>Sidst ændret @Model.UpdatedText.</p>
            }
        </div>
    </div>

    @if (!Model.HasProfile)
    {
        <div class="alert alert-warning mb-0"><icon name="info" /><p>Brugeren har ikke udfyldt sin profil endnu og kan ikke tilmelde sig vagter.</p></div>
    }
    else
    {
        @if (!Model.IsComplete)
        {
            <div class="alert alert-warning"><icon name="info" /><p>Profilen mangler oplysninger. Brugeren kan ikke tilmelde sig vagter.</p></div>
        }
        <dl class="details">
            <dt>Fulde navn</dt><dd>@Model.FullName</dd>
            <dt>Adresse</dt><dd>@Model.Address</dd>
            <dt>Telefonnummer</dt><dd>@Model.Phone</dd>
            <dt>E-mail</dt><dd>@Model.UserName</dd>
            <dt>Trøjestørrelse</dt><dd>@Model.ShirtSize</dd>
            <dt>Væskebilletter</dt><dd>@Model.DrinkTickets stk.</dd>
            <dt>Tivolibilletter</dt><dd>@Model.TivoliSheets ark</dd>
            <dt>Barnets navn</dt><dd>@Model.ChildName</dd>
            <dt>Klasse</dt><dd>@Model.ChildClass</dd>
        </dl>
    }
</section>
