@model web.ViewModels.Users.IndexUsersViewModel
@{
    ViewData["Title"] = "Brugere";
}
<div class="page-header">
    <div>
        <h1>Brugere</h1>
        <p>Forældre og administratorer, der kan logge ind. Kun administratorer kan oprette brugere.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><icon name="user-plus" />Opret bruger</a>
    </div>
</div>

@if (Model.Users.Count == 0)
{
    <div class="card empty-state">
        <icon name="users" />
        <h2>Der er ingen brugere endnu</h2>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table table-cards">
            <thead>
                <tr>
                    <th scope="col">Navn</th>
                    <th scope="col">Rolle</th>
                    <th scope="col">Status</th>
                    <th scope="col">Profil</th>
                    <th scope="col">Sidste login</th>
                    <th scope="col"><span class="visually-hidden">Handlinger</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="cell-main"><strong>@user.DisplayName</strong>@if (user.IsCurrentUser){<span class="muted small"> (dig)</span>}<br /><span class="muted small">@user.UserName</span></td>
                        <td data-label="Rolle">
                            @if (user.IsAdmin)
                            {
                                <span class="badge badge-info"><icon name="shield" />Administrator</span>
                            }
                            else
                            {
                                <span class="badge badge-neutral"><icon name="user" />Bruger</span>
                            }
                        </td>
                        <td data-label="Status">
                            @if (user.IsActive)
                            {
                                <span class="badge badge-success"><icon name="check" />Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge-draft"><icon name="lock" />Deaktiveret</span>
                            }
                        </td>
                        <td data-label="Profil">
                            <a asp-action="Profile" asp-route-id="@user.Id" class="badge @(user.HasCompleteProfile ? "badge-success" : "badge-warning")">
                                <icon name="@(user.HasCompleteProfile ? "check" : "alert-triangle")" />@(user.HasCompleteProfile ? "Udfyldt" : "Mangler")<span class="visually-hidden"> – se profilen for @user.DisplayName</span>
                            </a>
                        </td>
                        <td data-label="Sidste login" class="nowrap">@user.LastLoginText</td>
                        <td class="actions">
                            <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@user.Id" title="Ret"><icon name="edit" /><span class="btn-label">Ret</span><span class="visually-hidden"> @user.DisplayName</span></a>
                            <a class="btn btn-ghost btn-sm" asp-action="ResetPassword" asp-route-id="@user.Id" title="Ny adgangskode"><icon name="key" /><span class="btn-label">Ny adgangskode</span><span class="visually-hidden"> til @user.DisplayName</span></a>
                            @if (user.NeverLoggedIn && user.IsActive)
                            {
                                <form asp-action="Invite" asp-route-id="@user.Id" method="post" data-confirm="Send en ny invitation til @user.UserName? Tidligere invitationslinks holder op med at virke.">
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Send invitation igen"><icon name="send" /><span class="btn-label">Send invitation</span><span class="visually-hidden"> til @user.DisplayName</span></button>
                                </form>
                            }
                            @if (!user.IsCurrentUser)
                            {
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" data-confirm="Vil du slette @user.DisplayName? Det kan ikke fortrydes.">
                                    <button type="submit" class="btn btn-danger btn-sm" title="Slet"><icon name="trash" /><span class="btn-label">Slet</span><span class="visually-hidden"> @user.DisplayName</span></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
