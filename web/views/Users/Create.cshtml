@model web.ViewModels.Users.CreateUsersViewModel
@{
    ViewData["Title"] = "Opret bruger";
}
<a class="back-link" asp-action="Index"><icon name="arrow-left" />Tilbage til brugere</a>
<div class="page-header">
    <div>
        <h1>Opret bruger</h1>
        <p>Brugeren logger ind med sin e-mail. Med en invitation vælger brugeren selv sin adgangskode via et link i en mail, så du aldrig kender den.</p>
    </div>
</div>

<div class="card form">
    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="UserName" class="required"></label>
            <input asp-for="UserName" type="email" autocomplete="off" />
            <span asp-validation-for="UserName"></span>
        </div>

        <div class="field">
            <label asp-for="DisplayName" class="required"></label>
            <input asp-for="DisplayName" autocomplete="off" />
            <span asp-validation-for="DisplayName"></span>
        </div>

        <label class="checkbox"><input asp-for="SendInvitation" /> @Html.DisplayNameFor(m => m.SendInvitation)</label>
        <p class="help mb-1">Brugeren får en mail med et link til at vælge sin adgangskode. Linket gælder i 7 dage.</p>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span class="help">Kun hvis du ikke sender invitation. Mindst 12 tegn. Giv den videre på en sikker måde.</span>
            <span asp-validation-for="Password"></span>
        </div>

        <label class="checkbox"><input asp-for="IsAdmin" /> @Html.DisplayNameFor(m => m.IsAdmin)</label>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><icon name="check" />Opret bruger</button>
            <a class="btn btn-ghost" asp-action="Index">Annuller</a>
        </div>
    </form>
</div>
