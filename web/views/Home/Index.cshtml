@model web.ViewModels.Home.IndexHomeViewModel
@{
    ViewData["Title"] = "Forside";
    var isAdmin = User.IsInRole(UserClaimTypes.AdminRole);
}
<div class="page-header">
    <div>
        <h1>Velkommen, @User.FindFirst(UserClaimTypes.DisplayName)?.Value</h1>
        <p>Her får du overblik over dine vagter og tilmeldinger.</p>
    </div>
</div>

@if (!Model.ProfileComplete)
{
    <div class="alert alert-warning" role="status">
        <icon name="info" />
        <p><strong>Udfyld din profil.</strong> Du kan først tilmelde dig vagter, når din profil er udfyldt. <a asp-controller="Profile" asp-action="Index">Gå til Min profil</a></p>
    </div>
}

<div class="grid grid-2">
    <section class="card" aria-labelledby="profile-title">
        <div class="card-header">
            <span class="card-icon"><icon name="user" /></span>
            <div>
                <h2 id="profile-title">Min profil</h2>
                <p>Dine kontaktoplysninger, trøjestørrelse, billetter og barnets klasse.</p>
            </div>
        </div>
        <a class="btn btn-secondary" asp-controller="Profile" asp-action="Index"><icon name="user" />Gå til Min profil</a>
    </section>

    @if (isAdmin)
    {
        <section class="card" aria-labelledby="admin-title">
            <div class="card-header">
                <span class="card-icon"><icon name="users" /></span>
                <div>
                    <h2 id="admin-title">Administration</h2>
                    <p>Opret forældre og administratorer, og styr deres adgang.</p>
                </div>
            </div>
            <a class="btn btn-primary" asp-controller="Users" asp-action="Index"><icon name="users" />Brugere</a>
        </section>
    }
</div>
