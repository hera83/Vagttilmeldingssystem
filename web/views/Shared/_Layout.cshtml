@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthenticated && User.IsInRole(UserClaimTypes.AdminRole);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Vagttilmelding</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1764B8" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Vagttilmelding" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "is-authenticated" : "is-anonymous")@(isAdmin ? " is-admin" : "")">
    <partial name="_IconSprite" />
    <a class="skip-link" href="#main">Spring til indhold</a>

    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"><icon name="calendar" /></span>
                <span>Vagttilmelding</span>
            </a>
            @if (isAuthenticated)
            {
                <nav class="topnav" aria-label="Hovedmenu">
                    <a asp-controller="Home" asp-action="Index" aria-current="@Current("Home")"><icon name="home" />Forside</a>
                    <a asp-controller="Signup" asp-action="Index" aria-current="@Current("Signup")"><icon name="check-circle" />Ledige vagter</a>
                    <a asp-controller="MyShifts" asp-action="Index" aria-current="@Current("MyShifts")"><icon name="calendar" />Mine vagter</a>
                    <a asp-controller="Profile" asp-action="Index" aria-current="@Current("Profile")"><icon name="user" />Min profil</a>
                </nav>
                <div class="user-menu">
                    <a class="user-chip" asp-controller="Account" asp-action="ChangePassword" title="Skift adgangskode">
                        <icon name="user" /><span class="user-name">@User.FindFirst(UserClaimTypes.DisplayName)?.Value</span>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" data-logout>
                        <input type="hidden" name="pushEndpoint" value="" data-push-endpoint />
                        <button type="submit" class="btn btn-ghost btn-sm"><icon name="log-out" /><span class="hide-sm">Log ud</span></button>
                    </form>
                </div>
            }
        </div>
    </header>

    <div class="shell">
        @if (isAdmin)
        {
            <aside class="sidebar">
                <p class="sidebar-title" id="admin-menu-title">Administration</p>
                <nav aria-labelledby="admin-menu-title">
                    <a asp-controller="Dashboard" asp-action="Index" aria-current="@Current("Dashboard")"><icon name="grid" />Dashboard</a>
                    <a asp-controller="Events" asp-action="Index" aria-current="@Current("Events")"><icon name="calendar" />Begivenheder</a>
                    <a asp-controller="Users" asp-action="Index" aria-current="@Current("Users")"><icon name="users" />Brugere</a>
                    <a asp-controller="Mailbox" asp-action="Index" aria-current="@Current("Mailbox")"><icon name="inbox" />Indbakke</a>
                </nav>
            </aside>
        }
        <main id="main" class="main" tabindex="-1">
            <div class="alert alert-warning live-status" data-offline-status role="status" tabindex="-1" hidden><icon name="wifi-off" /><span><strong>Du er offline</strong> – tilmelding kræver internet.</span></div>
            <div class="alert alert-warning live-status" data-live-status role="status" aria-live="polite" hidden></div>
            <partial name="_Toasts" />
            @RenderBody()
        </main>
    </div>

    @if (isAuthenticated)
    {
        <nav class="bottomnav" aria-label="Menu">
            <a asp-controller="Home" asp-action="Index" aria-current="@Current("Home")"><icon name="home" /><span>Forside</span></a>
            <a asp-controller="Signup" asp-action="Index" aria-current="@Current("Signup")"><icon name="check-circle" /><span>Ledige</span></a>
            <a asp-controller="MyShifts" asp-action="Index" aria-current="@Current("MyShifts")"><icon name="calendar" /><span>Mine vagter</span></a>
            <a asp-controller="Profile" asp-action="Index" aria-current="@Current("Profile")"><icon name="user" /><span>Profil</span></a>
        </nav>
    }

    <partial name="_ConfirmDialog" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    @if (isAuthenticated)
    {
        <script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/js/realtime.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
