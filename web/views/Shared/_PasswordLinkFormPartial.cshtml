@model web.ViewModels.Account.PasswordLinkFormViewModel
@* Formularen til SetPassword (invitation) og ResetPassword (glemt adgangskode). Viser en forklaring, hvis linket ikke kan bruges. *@
@if (Model.LinkProblem is not null)
{
    <div class="alert alert-warning" role="alert">
        <icon name="alert-triangle" />
        <p><strong>@Model.LinkProblem</strong> Bed om et nyt link under <a asp-controller="Account" asp-action="ForgotPassword">Glemt adgangskode</a>, eller kontakt administratoren.</p>
    </div>
}
else
{
    <form asp-controller="Account" asp-action="@Model.FormAction" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <input asp-for="Token" type="hidden" />

        <div class="field">
            <label asp-for="NewPassword" class="required"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span class="help">Mindst 12 tegn. Brug fx tre-fire tilfældige ord.</span>
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword" class="required"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block"><icon name="check" />Gem adgangskode</button>
    </form>
}
