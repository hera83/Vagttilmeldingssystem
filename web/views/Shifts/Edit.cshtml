@model web.ViewModels.Shifts.EditShiftsViewModel
@{
    ViewData["Title"] = "Ret vagt";
}
<a class="back-link" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId"><icon name="arrow-left" />Tilbage til @Model.EventName</a>
<div class="page-header">
    <div>
        <h1>Ret vagt</h1>
        <p class="meta"><span><partial name="_ShiftStatusBadgePartial" model="Model.IsOpen" /></span></p>
    </div>
</div>

<div class="grid grid-sidebar">
    <section class="card" aria-labelledby="shift-title">
        <div class="card-header">
            <span class="card-icon"><icon name="calendar" /></span>
            <div>
                <h2 id="shift-title">Vagtoplysninger</h2>
                <p>Begivenhed: <strong>@Model.EventName</strong> (@Model.EventPeriodText)</p>
            </div>
        </div>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <partial name="_ShiftFieldsPartial" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><icon name="check" />Gem</button>
                <a class="btn btn-ghost" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">Annuller</a>
            </div>
        </form>
    </section>

    <aside class="card" aria-labelledby="status-title">
        <div class="card-header">
            <span class="card-icon"><icon name="info" /></span>
            <div>
                <h2 id="status-title">Godt at vide</h2>
            </div>
        </div>
        @if (Model.IsOpen)
        {
            <p>Vagten er åben for tilmelding. Ændrer du tidspunktet, ser forældrene det nye tidspunkt med det samme.</p>
        }
        else
        {
            <p>Vagten er en skjult kladde. Forældrene kan ikke se den endnu.</p>
        }
    </aside>
</div>
