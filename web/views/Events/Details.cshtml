@model web.ViewModels.Events.DetailsEventsViewModel
@{
    ViewData["Title"] = Model.Name;
}
<a class="back-link" asp-action="Index" asp-route-archived="@(Model.IsArchived ? "true" : null)"><icon name="arrow-left" />Tilbage til begivenheder</a>
<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="meta">
            <span><icon name="calendar" />@Model.PeriodText</span>
            <span><icon name="map-pin" />@Model.Location</span>
            @if (Model.IsArchived)
            {
                <span class="badge badge-neutral"><icon name="archive" />Arkiveret</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id"><icon name="edit" />Ret begivenhed</a>
        @if (Model.IsArchived)
        {
            <form asp-action="Unarchive" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-ghost"><icon name="refresh" />Gør aktiv igen</button>
            </form>
        }
        else
        {
            <form asp-action="Archive" asp-route-id="@Model.Id" method="post" data-confirm="Vil du arkivere @Model.Name? Den skjules fra listen over aktive begivenheder.">
                <button type="submit" class="btn btn-ghost"><icon name="archive" />Arkivér</button>
            </form>
        }
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Vil du slette @Model.Name? Det kan ikke fortrydes.">
            <button type="submit" class="btn btn-danger"><icon name="trash" />Slet</button>
        </form>
    </div>
</div>

<section class="section" aria-labelledby="shifts-title">
    <div class="section-header">
        <h2 id="shifts-title">Vagter <span class="muted">(@Model.TotalCount)</span></h2>
        <a class="btn btn-primary" asp-controller="Shifts" asp-action="Create" asp-route-eventId="@Model.Id"><icon name="plus" />Opret vagt</a>
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="card empty-state">
            <icon name="list" />
            <h3>Der er ingen vagter endnu</h3>
            <p>Opret vagterne, fx "Kiosk 17:00–19:00" eller "Oprydning 21:00–22:30". Nye vagter er skjulte kladder, indtil du åbner for tilmelding.</p>
        </div>
    }
    else
    {
        <nav class="tabs tabs-spaced" aria-label="Filtrér vagter efter status">
            <a asp-action="Details" asp-route-id="@Model.Id" aria-current="@(Model.StatusFilter is null ? "page" : null)">Alle <span class="count">@Model.TotalCount</span></a>
            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-status="Draft" aria-current="@(Model.StatusFilter == "Draft" ? "page" : null)">Kladder <span class="count">@Model.DraftCount</span></a>
            <a asp-action="Details" asp-route-id="@Model.Id" asp-route-status="Open" aria-current="@(Model.StatusFilter == "Open" ? "page" : null)">Åbne <span class="count">@Model.OpenCount</span></a>
        </nav>

        @if (Model.Shifts.Count == 0)
        {
            <div class="card empty-state"><h3>Ingen vagter med den status</h3></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-cards">
                    <thead>
                        <tr>
                            <th scope="col">Vagt</th>
                            <th scope="col">Dato</th>
                            <th scope="col">Tid</th>
                            <th scope="col">Besat</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Handlinger</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shift in Model.Shifts)
                        {
                            <tr>
                                <td class="cell-main"><strong>@shift.Title</strong></td>
                                <td data-label="Dato" class="nowrap">@shift.DateText</td>
                                <td data-label="Tid" class="nowrap">@shift.TimeText</td>
                                <td data-label="Besat">
                                    <span class="taken">
                                        <span>@shift.Taken af @shift.Capacity</span>
                                        <progress class="progress @(shift.Taken >= shift.Capacity ? "is-full" : "")" max="@shift.Capacity" value="@shift.Taken" aria-hidden="true"></progress>
                                    </span>
                                </td>
                                <td data-label="Status"><partial name="_ShiftStatusBadgePartial" model="shift.IsOpen" /></td>
                                <td class="actions">
                                    <a class="btn btn-ghost btn-sm" asp-controller="Shifts" asp-action="Assign" asp-route-id="@shift.Id" title="Tildel"><icon name="user-plus" /><span class="btn-label">Tildel</span><span class="visually-hidden"> personer til @shift.Title</span></a>
                                    <a class="btn btn-ghost btn-sm" asp-controller="Shifts" asp-action="Edit" asp-route-id="@shift.Id" title="Ret"><icon name="edit" /><span class="btn-label">Ret</span><span class="visually-hidden"> @shift.Title</span></a>
                                    <form asp-controller="Shifts" asp-action="Delete" asp-route-id="@shift.Id" method="post" data-confirm="Vil du slette vagten @shift.Title? Det kan ikke fortrydes.">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Slet"><icon name="trash" /><span class="btn-label">Slet</span><span class="visually-hidden"> @shift.Title</span></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

<section class="card mt-2" aria-labelledby="details-title">
    <div class="card-header">
        <span class="card-icon"><icon name="info" /></span>
        <div>
            <h2 id="details-title">Om begivenheden</h2>
        </div>
    </div>
    <dl class="details">
        <dt>Periode</dt><dd>@Model.PeriodText</dd>
        <dt>Sted</dt><dd>@Model.Location</dd>
        <dt>Beskrivelse</dt>
        <dd class="pre-line">@(string.IsNullOrWhiteSpace(Model.Description) ? "Ingen beskrivelse." : Model.Description)</dd>
    </dl>
</section>
