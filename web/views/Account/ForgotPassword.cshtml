@model web.ViewModels.Account.ForgotPasswordAccountViewModel
@{
    ViewData["Title"] = "Glemt adgangskode";
}
<a class="back-link" asp-action="Login"><icon name="arrow-left" />Til log ind</a>
<div class="card form narrow">
    <div class="card-header">
        <span class="card-icon"><icon name="key" /></span>
        <div>
            <h1>Glemt adgangskode</h1>
            <p>Skriv den e-mail, du er oprettet med. Så sender vi et link, hvor du kan vælge en ny adgangskode.</p>
        </div>
    </div>
    <form asp-action="ForgotPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="Email" class="required"></label>
            <input asp-for="Email" type="email" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block"><icon name="send" />Send link</button>
    </form>
    <p class="muted small mt-1">Linket gælder i 1 time. Får du ingen mail, så tjek spam-mappen, eller kontakt administratoren.</p>
</div>
