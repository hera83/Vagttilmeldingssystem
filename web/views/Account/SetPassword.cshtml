@model web.ViewModels.Account.SetPasswordAccountViewModel
@{
    ViewData["Title"] = "Vælg adgangskode";
}
<div class="card form narrow">
    <div class="card-header">
        <span class="card-icon"><icon name="lock" /></span>
        <div>
            <h1>Velkommen til Vagttilmelding</h1>
            <p>Vælg den adgangskode, du vil logge ind med. Dit brugernavn er din e-mail.</p>
        </div>
    </div>
    <partial name="_PasswordLinkFormPartial" model="Model" />
</div>
