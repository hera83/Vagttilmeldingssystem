@model web.ViewModels.Account.ChangePasswordAccountViewModel
@{
    ViewData["Title"] = "Skift adgangskode";
}
<div class="page-header">
    <div>
        <h1>Skift adgangskode</h1>
        <p>Den nye adgangskode skal være mindst 12 tegn. Du forbliver logget ind på denne enhed, men andre enheder bliver logget ud.</p>
    </div>
</div>

<div class="card form">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="CurrentPassword" class="required"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>

        <div class="field">
            <label asp-for="NewPassword" class="required"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword" class="required"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><icon name="check" />Gem ny adgangskode</button>
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Annuller</a>
        </div>
    </form>
</div>
